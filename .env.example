# Contact form (app/api/contact/route.ts) – sends requests by e-mail via SMTP.
# Without SMTP_HOST, SMTP_USER and SMTP_PASS the form shows an honest
# "currently unavailable – please call or e-mail" message (no fake success).

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for port 465 (implicit TLS), otherwise "false"
SMTP_SECURE=false
SMTP_USER=info@haarzentrum-mainz.de
SMTP_PASS=change-me

# Recipient of contact requests (defaults to info@haarzentrum-mainz.de)
CONTACT_TO=info@haarzentrum-mainz.de
# Sender address – must be allowed by your SMTP provider (defaults to SMTP_USER)
CONTACT_FROM="Haarzentrum Mainz Website <info@haarzentrum-mainz.de>"
